{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "__USER_HOME__/.config/fastfetch/pagoda.txt",
    "padding": {
      "top": 1,
      "left": 2,
      "right": 3
    },
    "color": {
      "1": "38;5;250",
      "2": "38;5;251",
      "3": "38;5;252"
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "38;5;250",
      "title": "38;5;251",
      "output": "38;5;252"
    }
  },
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "display",
    "wm",
    "terminal",
    "terminalfont",
    "cpu",
    "gpu",
    "memory",
    "disk",
    "battery",
    "locale",
    "break",
    "colors"
  ]
}
